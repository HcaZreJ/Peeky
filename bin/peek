#!/usr/bin/env bash
# Usage:
#   peek [--app] [--dev] [<path>[:line[:col]]]     no path = peek .
#
# 在终端里运行(标准输出是终端)时,在当前终端里打开终端版 peek-tui;--app 改为打开 Peeky app 窗口。
# 标准输出不是终端(管道、脚本、agent 的后台 shell)时照旧打开 app。
# --dev 强制走本地 dev 版(~/Applications/Peeky Dev.app,来自 bash scripts/build-app.sh --install)。
# app 默认按顺序探测:/Applications/Peeky.app (Cask) → ~/Applications/Peeky.app (用户装的正式版) → ~/Applications/Peeky Dev.app (fallback)。
set -euo pipefail

force_dev=false
use_app=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    --dev) force_dev=true; shift ;;
    --app) use_app=true; shift ;;
    *) break ;;
  esac
done

raw_arg="${1:-.}"

# 解析 symlink(~/.local/bin/peek → app 包里的这份脚本),找到脚本真正所在的目录。
script_path="${BASH_SOURCE[0]}"
while [[ -L "$script_path" ]]; do
  link="$(readlink "$script_path")"
  [[ "$link" == /* ]] || link="$(dirname "$script_path")/$link"
  script_path="$link"
done
script_dir="$(cd "$(dirname "$script_path")" && pwd)"

expand_path() {
  local p="$1"
  if [[ "$p" == "~" ]]; then
    p="$HOME"
  elif [[ "$p" == "~/"* ]]; then
    # 模式里的 ~ 必须加引号,否则 bash 先把它展开成 $HOME,前缀永远匹配不上。
    p="$HOME/${p#"~/"}"
  fi
  if [[ "$p" != /* ]]; then
    if [[ "$p" == "." ]]; then
      p="$PWD"
    else
      p="$PWD/$p"
    fi
  fi
  printf '%s' "$p"
}

urlencode() {
  local py=python3
  if [[ -x /usr/bin/python3 ]]; then
    py=/usr/bin/python3
  fi
  "$py" -c '
import sys
from urllib.parse import quote
print(quote(sys.argv[1], safe=""))
' "$1"
}

DEV_APP="$HOME/Applications/Peeky Dev.app"
CASK_APP="/Applications/Peeky.app"
USER_APP="$HOME/Applications/Peeky.app"

# 终端版的位置:与本脚本同一个 app 包 → 选中的 app 包 → 仓库里的开发构建。
find_peek_tui() {
  local candidates=("$script_dir/../MacOS/peek-tui")
  if $force_dev; then
    candidates+=("$DEV_APP/Contents/MacOS/peek-tui")
  else
    candidates+=("$CASK_APP/Contents/MacOS/peek-tui" "$USER_APP/Contents/MacOS/peek-tui" "$DEV_APP/Contents/MacOS/peek-tui")
  fi
  candidates+=("$script_dir/../.build/release/peek-tui")
  local candidate
  for candidate in "${candidates[@]}"; do
    if [[ -x "$candidate" ]]; then
      printf '%s' "$candidate"
      return 0
    fi
  done
  return 1
}

abs_arg="$(expand_path "$raw_arg")"

target="$abs_arg"
line=""
column=""

if [[ ! -e "$abs_arg" ]]; then
  if [[ "$abs_arg" =~ ^(.+):([1-9][0-9]*)(:([1-9][0-9]*))?$ ]]; then
    candidate="${BASH_REMATCH[1]}"
    if [[ -e "$candidate" ]]; then
      target="$candidate"
      line="${BASH_REMATCH[2]}"
      column="${BASH_REMATCH[4]}"
    fi
  fi
fi

if [[ ! -e "$target" ]]; then
  # 报展开后的完整路径:相对路径拼错目录时,用户一眼能看出是在哪找的。
  echo "peek: no such path: $abs_arg" >&2
  if [[ "$raw_arg" != /* && "$raw_arg" != "~"* ]]; then
    echo "peek: relative paths start from the current directory ($PWD); use ~/... or /... to open from anywhere" >&2
  fi
  exit 1
fi

if ! $use_app && [[ -t 1 ]] && peek_tui="$(find_peek_tui)"; then
  exec "$peek_tui" "$abs_arg"
fi

if $force_dev; then
  if [[ ! -d "$DEV_APP" ]]; then
    echo "peek: --dev requested but $DEV_APP not found; run: bash scripts/build-app.sh --install" >&2
    exit 1
  fi
  APP_PATH="$DEV_APP"
else
  APP_PATH=""
  for candidate in "$CASK_APP" "$USER_APP" "$DEV_APP"; do
    if [[ -d "$candidate" ]]; then
      APP_PATH="$candidate"
      break
    fi
  done
  if [[ -z "$APP_PATH" ]]; then
    echo "peek: Peeky.app not found; install via 'brew install --cask peeky' or 'bash scripts/build-app.sh --install'" >&2
    exit 1
  fi
fi

# dev bundle 声明 peeky-dev:// scheme,正式 bundle 声明 peeky:// scheme。选中哪份就用哪份。
if [[ "$APP_PATH" == "$DEV_APP" ]]; then
  scheme="peeky-dev"
else
  scheme="peeky"
fi

encoded_path="$(urlencode "$target")"
encoded_cwd="$(urlencode "$PWD")"

url="${scheme}://open?path=${encoded_path}&cwd=${encoded_cwd}"
if [[ -n "$line" ]]; then
  url="${url}&line=${line}"
fi
if [[ -n "$column" ]]; then
  url="${url}&column=${column}"
fi

open -a "$APP_PATH" "$url"

display="$target"
if [[ -n "$line" ]]; then
  display="${display}:${line}"
  if [[ -n "$column" ]]; then
    display="${display}:${column}"
  fi
fi

echo "peek → ${display}"
